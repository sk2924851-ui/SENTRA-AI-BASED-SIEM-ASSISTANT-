# Copy to .env and export these (or set them in your shell / Docker env). Everything is optional:
# without credentials SENTRA runs fully offline and notifications go to ./outbox/ (dry-run).

# --- server ---
SENTRA_HOST=127.0.0.1
SENTRA_PORT=5000
# Require this key in the X-API-Key header for POST /api/events (real-time ingestion)
SENTRA_API_KEY=
AUTO_NOTIFY=1            # auto-notify new High/Critical incidents (1/0)
SENTRA_DRY_RUN=0         # 1 = never send, always write to outbox/

# --- threat intelligence (live lookups) ---
ABUSEIPDB_API_KEY=
VT_API_KEY=

# --- notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TEAMS_WEBHOOK_URL=
